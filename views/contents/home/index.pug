extends ../../layouts/hlayout

block title
  | Indonesia Care Center

block csslink
  link(rel='stylesheet' href='/icc/css/home.css')
  link(rel='stylesheet' href='/icc/css/artikel.css')
  link(rel='stylesheet' href='/icc/css/charity.css')
  link(rel='stylesheet' href='/icc/css/komunitas.css')
  link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css")

block content
  if typeof userData !== 'undefined' && userData
    if userData.type === 'tsk' || userData.type === 'kumiai'
      section.welcome-company-section.py-5
        .container
          .d-flex.justify-content-center.align-items-center.mb-4
            .text-content
              h4.fw-bold.text-center(style="color: #BE1E2D;") Selamat Datang, #{userData.companyDetail.name || "TSK"}
              p.text-center(style="color: black;") Pantau dan kelola pekerja migran Indonesia dengan lebih efisien melalui dashboard kami

          .d-flex.justify-content-center.mb-4
            a.btn.btn-primary-600.d-flex.justify-content-center.align-items-center(
              href="/dashboard/perusahaan",
              style="width: 240px; border-radius: 8px; background-color: #BE1E2D; color: white;"
            ) Lihat Dashboard Lengkap

          br
          
          .d-flex.flex-wrap.justify-content-center.gap-4.mt-4
            a(href="/pesertaiso", class="text-decoration-none text-dark")
              .card.card-hover.shadow.text-center.p-3(
                  style="min-width: 260px; max-width: 300px; border-radius: 10px; border: 2px solid #BE1E2D;"
                )
                i.bi.bi-people-fill.fs-1.mb-3(style="color: #BE1E2D;")
                h5.card-title.fw-bold Peserta ISO
                p.card-text.text-muted Data dan monitoring peserta pelatihan ISO

            a(href="/list/perusahaan", class="text-decoration-none text-dark")
              .card.card-hover.shadow.text-center.p-3(
                  style="min-width: 260px; max-width: 300px; border-radius: 10px; border: 2px solid #BE1E2D;"
                )
                i.bi.bi-briefcase-fill.fs-1.mb-3(style="color: #BE1E2D;")
                h5.card-title.fw-bold Mitra
                p.card-text.text-muted Kelola dan lihat daftar mitra kerja

            a(href="/loker/perusahaan", class="text-decoration-none text-dark")
              .card.card-hover.shadow.text-center.p-3(
                  style="min-width: 260px; max-width: 300px; border-radius: 10px; border: 2px solid #BE1E2D;"
                )
                i.bi.bi-megaphone-fill.fs-1.mb-3(style="color: #BE1E2D;")
                h5.card-title.fw-bold Lowongan Kerja
                p.card-text.text-muted Buat dan monitoring lowongan kerja


          //- .divider.mt-5

          //- section.py-4
          //-   .container
          //-     h5.fw-bold.text-center.mb-4(style="color: #BE1E2D;") Statistik
          //-     .row.align-items-center.justify-content-center
          //-       #dashboard-perusahaan(style="width: 100%")


  section.hero.position-relative.text-white.d-flex.align-items-end.justify-content-center#hero
    img.hero-img(src="/icc/images/header.png" alt="Hero Image")
    .hero-overlay

    .hero-content.text-center
      h3.hero-title Aman & Nyaman Mempekerjakan Pekerja Migran Indonesia Bersama ICC!
      .hero-description.mt-3
        p.lead Solusi Pengawasan, Manajemen, dan Adaptasi untuk Perusahaan Jepang –
          br
          | Minimalkan Risiko, Maksimalkan Produktivitas.
        p.mt-2.fst-italic(style="font-size: 0.95rem;") Bergabung bersama ICC dan dapatkan akses ke fitur-fitur eksklusif yang dirancang khusus untuk mendukung operasional perusahaan Anda secara efisien dan terpercaya.
      a.btn.btn-outline-light.mt-5(href="/register") Konsultasi Gratis Untuk Perusahaan

  section.countheader-section.py-5
    .container
      .row.align-items-center.h-50
        #count-header
  
  section.siapakami-section.py-5
    .container
      .row.align-items-center.mt-5
        .col-md-4.text-center
          img(src="/icc/images/icclogo.png" alt="ICC Logo" class="img-fluid")

        .col-md-8
          h4.fw-bold.text-white.mb-3 Siapa Kami?
          p.text-white Indonesian Care Center (ICC) adalah lembaga sertifikasi dan pendampingan pekerja migran Indonesia berbasis teknologi. Kami memastikan perusahaan Jepang mendapatkan tenaga kerja terlatih yang telah melalui proses:

          ul.text-white
            li Seleksi ketat (kesehatan, bahasa, keterampilan)
            li Pelatihan budaya kerja Jepang
            li Pengawasan berstandar ISO

          //- a.btn.btn-outline-light.mt-3(href="/tentang") Selengkapnya

  section.komitmen-section.py-5
    .container
      .row
        .col-md-3.d-flex.align-items-center
          .text-start
            h6.text-danger(style="font-weight: bold;") Komitmen Kami
            h4.fw-bold Perlindungan Menyeluruh

        .col-md-9
          .row.g-3
            .col-md-4
              .card-komitmen
                img(src="/icc/images/law.png" alt="Pengawasan" class="img-top")
                .card-body
                  h5.card-title Pengawasan
                  br
                  p.card-text Kontrak kerja transparan, pemantauan hak pekerja.

            .col-md-4
              .card-komitmen
                img(src="/icc/images/hospital.png" alt="Kesehatan" class="img-top")
                .card-body
                  h5.card-title Kesehatan
                  br
                  p.card-text Asuransi dan akses layanan medis.

            .col-md-4
              .card-komitmen
                img(src="/icc/images/tech.png" alt="Teknologi" class="img-top")
                .card-body
                  h5.card-title Teknologi
                  br
                  p.card-text Dashboard real-time untuk pelaporan masalah.


  section.tantangan-section
    .container
      .row
        .col-md-6.text-white
          h4.fw-bold.mb-4.text-white Tantangan Pekerja Migran Indonesia
          br
          p(style="font-size: 18px;")
            | Setiap tahun, ribuan Pekerja Migran Indonesia (PMI) berangkat ke luar negeri, termasuk Jepang, demi meningkatkan kesejahteraan keluarga. Namun, mereka kerap menghadapi tantangan serius, seperti kontrak kerja yang tidak adil, minimnya pengawasan, serta kesulitan budaya dan bahasa. Kondisi ini menegaskan pentingnya kehadiran kita untuk mendampingi dan melindungi mereka.
            br

  section.about-section.py-5
    .container
        .row.align-items-center
            .col-md-4.text-center
                img(src="/icc/images/icc.png")

            .col-md-7
                h4.fw-bold(style="color: #BE1E2D; font-weight: bold;") Lahirnya ICC (Indonesia Care Center)
                p Untuk menjawab keresahan ini, lahirlah Indonesia Care Center (ICC), sebuah lembaga yang  didedikasikan untuk melindungi dan memberdayakan pekerja migran Indonesia. ICC hadir  sebagai jembatan antara PMI, perusahaan pemberi kerja di Jepang, perusahaan pengirim  dari Indonesia, dan pemerintah. Tujuannya jelas: memastikan hak-hak PMI terlindungi,  memantau kondisi kerja mereka, dan memenuhi tugas pemerintah Indonesia dalam  memberikan perlindungan kepada warga negaranya di luar negeri.

  section.app-features.py-5#fitur-icc
    .container
      .row.align-items-center
        .col-lg-7
          h4(style="color: #BE1E2D; font-weight: bold;") Fungsi Web dan Aplikasi ICC
          br
          p.text-muted
            | ICC tidak hanya hadir secara fisik, tetapi juga melalui web dan aplikasi yang dirancang khusus untuk memudahkan semua pihak. Di dalamnya, terdapat berbagai fitur canggih seperti:

          .fitur-list.mt-4
            .row.mb-3
              .col-auto.pt-1
                img(src="icc/images/check-icon.png", alt="check icon", width="18", height="18")
              .col
                p.mb-0.fw-bold Tracking System
                p.mb-0.text-muted Memantau lokasi dan status kerja PMI.

            .row.mb-3
              .col-auto.pt-1
                img(src="icc/images/check-icon.png", alt="check icon", width="18", height="18")
              .col
                p.mb-0.fw-bold Layanan Pengaduan
                p.mb-0.text-muted Memudahkan PMI melaporkan masalah kerja dan perlindungan di luar pekerjaan.

            .row.mb-3
              .col-auto.pt-1
                img(src="icc/images/check-icon.png", alt="check icon", width="18", height="18")
              .col
                p.mb-0.fw-bold Informasi Lowongan
                p.mb-0.text-muted Membantu PMI menemukan pekerjaan baru setelah kontrak berakhir.

            .row.mb-3
              .col-auto.pt-1
                img(src="icc/images/check-icon.png", alt="check icon", width="18", height="18")
              .col
                p.mb-0.fw-bold Pelatihan Online
                p.mb-0.text-muted Materi bahasa Jepang dan budaya kerja untuk membantu adaptasi. Dengan teknologi ini, ICC memastikan proses belajar lebih efisien dan terpercaya.

            .row.mb-3
              .col-auto.pt-1
                img(src="icc/images/check-icon.png", alt="check icon", width="18", height="18")
              .col
                p.mb-0.fw-bold Komunitas
                p.mb-0.text-muted Membantu PMI membangun jejaring dan saling mendukung di Jepang.

            .row.mb-3
              .col-auto.pt-1
                img(src="icc/images/check-icon.png", alt="check icon", width="18", height="18")
              .col
                p.mb-0.fw-bold Charity
                p.mb-0.text-muted Menyediakan ruang berbagi cerita, materi inspiratif, dan dukungan moral dari PMI lain.

        .col-lg-5.text-center.mt-6
          img.img-fluid(
            src="icc/images/icc_app.png",
            alt="Mockup Aplikasi ICC",
            style="max-width: 90%;"
          )

  section.sebaran-section.py-5
    .container
      .row
        .col-md-12
          .row.g-3
            img.img-fluid(
            src="icc/images/sebaran.png",
            style="max-width: 100%;"
          )

  section.count-section.py-5#countinfo
    .container
      p.text-center
          img(src="/icc/images/logoicc.png" alt="Indonesia Care Center Logo" class="logo" style="width: 220px; height: 120px; object-fit: contain;")
      h3.text-center(style="color: rgba(190, 30, 45, 1); font-weight: bold;") ICC Sebagai Solusi untuk Semua Pihak
      br
      p.text-center.text-desc
        | Kehadiran ICC bukan hanya solusi bagi pekerja migran, tetapi juga bagi pemerintah Indonesia, perusahaan Jepang, dan perusahaan pengirim dari Indonesia.
      br
      
      ul.text-desc-list
        li
          strong Bagi Pemerintah :
          |  ICC membantu memastikan perlindungan warga negara di luar negeri.
        li
          strong Bagi Perusahaan Jepang :
          |  ICC memastikan ketersediaan tenaga kerja yang terlatih dan berkualitas.
        li
          strong Bagi Perusahaan Pengirim (Mitra) :
          |  ICC memudahkan proses rekrutmen dan penempatan.
        li
          strong Bagi PMI :
          |  ICC adalah sahabat yang selalu siap membantu dalam setiap langkah mereka menuju kesuksesan.
      .divider
      br
      h6.text-center(style="color: rgba(190, 30, 45, 1); font-weight: bold;") Detail Statistik
      #count-page
      br

  section.testimonial-section.py-4#testimonial
    .container
      h3.text-center.mb-2(style="color: #FFFFFF; font-weight: bold;") Mengenal Lebih Dekat dengan Peserta
      .divider
      p.text-center.mb-4(style="color: #FFFFFF; font-weight: bold; margin-top: 10px;")
        | Temui para peserta luar biasa yang telah berkontribusi dan berkembang melalui program ini. Kisah mereka bisa menjadi inspirasi untuk langkah Anda selanjutnya.
      br
      -
        const testimonials = [
          {
            name: 'Rifal Rey Agung Hartono',
            role: 'PMI',
            background: 'SMK Teknik Mesin, Bandung',
            skills: ['CNC', 'Pengelasan', 'Teknik Mekanik'],
            img: '/icc/images/peserta1.png',
            text: '“Program ini membantu saya beradaptasi dan berkembang di Jepang.”',
            video: 'https://www.youtube.com/embed/NCjZERKiwQI?si=M6x97iOb7hVw9G96'
          },
          {
            name: 'Fitrie Elsa Fajria',
            role: 'Magang',
            background: 'Politeknik Negeri Malang, Akuntansi',
            skills: ['Microsoft Excel', 'Dokumentasi', 'Bahasa Jepang Dasar'],
            img: '/icc/images/peserta2.png',
            text: '“Saya belajar banyak tentang budaya kerja di Jepang.”',
            video: 'https://www.youtube.com/embed/Q7FYle_hQeA?si=ijtbQPFHtbzrWP4n'
          },
          {
            name: 'Niken Andini Flianda',
            role: 'PMI',
            background: 'SMK BINA INFORMATIKA, KOTA BOGOR ',
            skills: ['Maintenance Mesin', 'Pengelasan', 'Teknik Listrik'],
            img: '/icc/images/peserta3.png',
            text: '“Program yang sangat membantu saya untuk berkembang dan menjadikan SDM Yang berkualitas, Terima kasih Untuk Sensei dan Lembaga Pengirim.”',
            video: 'https://www.youtube.com/embed/EPlBNsicelA?si=7lSJKDj59Mm_pH4p'
          }
        ]

      .row.g-4
        each testimonial, index in testimonials
          .col-md-4
            .card.shadow-sm.text-center.p-4(
              style="border-radius: 15px; background: white; cursor: pointer; height: 100%;"
              data-bs-toggle="modal"
              data-bs-target="#testimonialModal" + index
            )
              img.avatar.mb-3.mt-3(
                src=testimonial.img,
                alt=testimonial.name,
                style="width: 100px; height: 100px; object-fit: cover; border-radius: 50%; margin: 0 auto;"
              )
              h5.mt-2= testimonial.name
              p.text-muted.mt-2= testimonial.text

      each testimonial, index in testimonials
        .modal.fade(id="testimonialModal" + index, tabindex="-1", aria-labelledby="modalLabel" + index, aria-hidden="true")
          .modal-dialog.modal-lg.modal-dialog-centered
            .modal-content
              .modal-header
                button.btn-close(type="button", data-bs-dismiss="modal", aria-label="Close")
              .modal-body
                .text-center
                  img.mb-3(
                    src=testimonial.img,
                    alt=testimonial.name,
                    style="width: 120px; height: 120px; object-fit: cover; border-radius: 50%;"
                  )
                  h6.mb-1.text-muted= testimonial.name
                  p.mt-3= testimonial.text
                  p.mb-0.text-secondary: strong Background
                  p.mt-0.mb-2.text-muted= testimonial.background
                  br
                  p.mb-0.text-secondary: strong Skills
                  ul.list-unstyled.d-flex.flex-wrap.gap-2.mt-2.justify-content-center
                    each skill in testimonial.skills
                      li
                        span.badge(
                          style="background-color: #BE1E2D; border-radius: 20px; padding: 6px 14px; font-size: 0.875rem; color: white;"
                        )= skill
                  br
                  .ratio.ratio-16x9.mt-4.mb-4
                    iframe(
                      src=testimonial.video,
                      title="YouTube video",
                      allowfullscreen
                    )
                  a.btn.btn-danger.mt-4(href="/register") Lebih Lanjut


  section.artikel-section.py-5(id="artikel")
    .container
      .d-flex.justify-content-between.align-items-start.mb-4
        .text-content
          h3.fw-bold Artikel
          p.text-muted Artikel-artikel kami menyajikan wawasan mendalam mengenai isu-isu terkini, mengulas tantangan global, dan menawarkan solusi inovatif. Temukan lebih banyak informasi yang akan memperluas pandangan dan memperkaya pengetahuan Anda!.
        a.btn.btn-primary-600(style="width: 25%;" href="/artikel") Lihat Semua Artikel

      .divider
      br
      #artikel-page(style="position: relative;")
        #loadingOverlayArtikel
          .spinner

      br
      .divider


  //- section.campaign-section.py-5
    .container
      .row.align-items-center.h-100
        .col-md-7
          h3.fw-bold.text-dark Never lose your favorite this webapp again.
          p.text-muted Save and organize your most important web discoveries with our powerful bookmarking tool. Access your curated content anywhere, anytime.

          // Subscription Form
          form.d-flex
            input.form-control(type="email" placeholder="Enter your email")
            button.btn.btn-primary-600 Daftar

          p.text-muted(style="margin-top: 1rem; font-size: 12px;") By clicking Sign Up, you’re confirming that you agree with our Privacy Policy.

        // Right: Image
        .col-md-4.text-center
          img(src="/icc/images/amico.png" alt="Illustration" class="campaign-img")

  if typeof userData !== 'undefined' && userData
    if userData.type === 'peserta'
      section.communityh-section.py-5(id="community")
        .container
          .d-flex.justify-content-between.align-items-start.mb-4
            .text-content
              span.mb-3.text-primary-600.fw-bold Komunitas
              h3.fw-bold Temukan Komunitas yang Mendukung Anda di Jepang!
              p.text-muted Bergabunglah dengan ribuan pekerja migran Indonesia di berbagai kota di Jepang.
            a.btn.btn-primary-600(style="width: 25%;" href="/komunitas") Lihat Semua Komunitas

          .divider
          br
          #community-page
          br
          .divider
  
      section.communityf-section.py-5
        .container
            .row.align-items-center
                .col-md-6.text-center
                    img(src="/icc/images/pana.png" alt="Community Illustration" class="community-img")

                .col-md-6
                    h2.fw-bold ICC Community
                    p Bergabunglah dengan komunitas ICC dan jadi bagian dari gerakan yang penuh semangat! Temui orang-orang dengan visi yang sama, berbagi pengalaman, dan saling mendukung untuk mencapai tujuan bersama. Di sini, kita tumbuh bersama dalam kebersamaan dan kepedulian.

  section.charityh-section.py-5(id="charity")
    .container
        .row.align-items-center
            .col-md-6
                span.mb-3.text-primary-600.fw-bold Charity
                h5.mb-3.fw-bold.text-dark Langkah Menumbuhkan Rasa Peduli terhadap Sesama
                p.mb-3.text-muted.max-w-634-px.text-md
                  | Kepedulian terhadap sesama menjadi salah satu sikap yang menunjang kehidupan bersosialisasi. 
                  | Menerapkan sikap ini bisa mendorong setiap orang lebih bahagia dan berdaya bagi lingkungannya.
                p.mb-3.text-muted.max-w-634-px.text-md.mt-2
                  | Merangkum dari berbagai sumber, Human Initiative memberikan langkah-langkah untuk menumbuhkan rasa peduli terhadap sesama. 
                  | Yuk, simak di bawah ini.

                form.d-flex
                a.btn.btn-primary-600(style="width: 35%;" href="/charity") Lihat Semua Charity
            .col-md-6.text-center
                img(src="/icc/images/pedulisesama.png" alt="Charity Illustration" class="charity-img")
        br
        .divider
        br
        #charity-page(style="position: relative;")
          #loadingOverlayCharity
            .spinner
        br
        .divider

  //- section.charityf-section.py-5
