  //-               p Bergabunglah dalam gerakan kebaikan! Dukung upaya sosial dan beri dampak positif melalui donasi. Setiap kontribusi Anda membawa perubahan bagi mereka yang membutuhkan. Mari berbagi, mari peduli!
  //-           // Left: Image
  //-           .col-md-6.text-center
  //-               img(src="/icc/images/rafiki.png" alt="Charity Illustration" class="charity-img")
  
  section.contact-section.py-5(id="contact")
    .container
      .d-flex.justify-content-between.align-items-start.mb-4
        .text-content
          h3.fw-bold Contact
      .divider
      br
      #contact-page(style="position: relative;")
        #loadingOverlayContact
          .spinner
      br
      .divider

block script
  script(src='/icc/js/artikel/index.js')
  script(src='/icc/js/charity/index.js')
  script(src='/icc/js/contact/index.js')
