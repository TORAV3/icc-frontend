extends ../../layouts/dlayout

block title
  | Profil Peserta
block csslink
  link(rel='stylesheet' href='/icc/css/profilu.css')

block content
  .banner-container
    img.banner-image(src="/icc/images/frame1.png" alt="Banner")
  hr.divider
  .profsec
    .profile-picture
      img#avatarImage.profile-img(src="" alt="Avatar Picture")
      button.btn.btn-prof(type="button" title="Profile Pic")
        iconify-icon(icon="solar:camera-linear" width="20" height="20")
    .profile-details
      h5#fullNameHeader 
      p#idHeader.text-muted 
      p#statusHeader(style="font-size:17px;font-weight:600;") 
    button.btn.btn-share(type="button" title="Preview CV")
      iconify-icon(icon="solar:file-favourite-outline" width="20" height="20")

  #index-page

block script
  script(src='/icc/js/profil/peserta.js')
  script(src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js" type="text/javascript")

block js
  script.
    const token = "#{token}"
    const id = "#{id}"
    const userId = "#{userData.id}"